{
  "name": "english-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "English Daily 英语教学平台：教师出题布置、学生每日练习与订正",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/node/main.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/finish-demo.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
